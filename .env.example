PORT=3000

MONGODB_URI=mongodb://localhost:27017/hr-app

# Phase 8: true = parse with the LLM (Groq), false = regex/dictionary parser
USE_LLM_PARSER=false
GROQ_API_KEY=YOUR_KEY
# Optional second Groq key, used when the first one is rate-limited
GROQ_API_KEY_FALLBACK=
# Optional, defaults to openai/gpt-oss-120b
LLM_MODEL=openai/gpt-oss-120b

# Phase 9: embeddings
MISTRAL_API_KEY=YOUR_KEY
MISTRAL_EMBED_MODEL=mistral-embed
EMBEDDING_DIMENSION=1024

# Batch ingestion
MONGODB_DB=hr_app
RESUME_SOURCE_DIR=resumes
# 5 or 10 files per run
INGESTION_BATCH_SIZE=5
INGESTION_CONCURRENCY=2

# Phase 14: Atlas Vector Search index on resumes.embedding
VECTOR_SEARCH_INDEX=resume_vector
# Phase 15: score resumes in the app when the Atlas index is missing (false = return 503)
LOCAL_SEARCH_FALLBACK=true

# Retrieval module
BM25_SEARCH_INDEX=resume_bm25
RETRIEVAL_DEFAULT_TOP_K=20

# Retrieval Phase 10: Groq LLM re-ranking and summaries
GROQ_MODEL=openai/gpt-oss-120b
RERANK_DEFAULT_TOP_N=10

# Retrieval Phase 17: max JSON request body (larger bodies get HTTP 413)
REQUEST_BODY_LIMIT=100kb
